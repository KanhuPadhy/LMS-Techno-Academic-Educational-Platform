name: E2E Parallel (Playwright + Cypress + Publish Playwright Report)

on:
  pull_request:
    branches: [ main ]
  push:
    branches: [ main ]
  workflow_dispatch:

# Allow page deployment via GITHUB_TOKEN
permissions:
  contents: read
  pages: write
  id-token: write

env:
  BACKEND_DIR: backend
  FRONTEND_DIR: frontend
  PLAYWRIGHT_TEST_DIR: playwright_tests
  CYPRESS_DIR: cypress_tests
  BACKEND_HOST: 127.0.0.1
  BACKEND_PORT: 5001
  FRONTEND_PORT: 5173
  DATABASE_URL: postgresql://postgres:postgres@localhost:5433/testdb

jobs:
  playwright:
    name: Playwright E2E
    runs-on: ubuntu-latest
    timeout-minutes: 30
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: testdb
        ports:
          - 5433:5432
        options: >-
          --health-cmd="pg_isready -U postgres"
          --health-interval=5s
          --health-timeout=5s
          --health-retries=5
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'

      - name: Install backend dependencies
        working-directory: ${{ env.BACKEND_DIR }}
        run: |
          python -m venv venv
          . venv/bin/activate
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: Start backend
        working-directory: ${{ env.BACKEND_DIR }}
        run: |
          . venv/bin/activate
          nohup python run.py > backend.out 2>&1 &
          echo "Backend started."

      - name: Wait for backend to be ready
        run: |
          for i in $(seq 1 40); do
            if curl -s "http://${{ env.BACKEND_HOST }}:${{ env.BACKEND_PORT }}/api/v1/knime/workflows" >/dev/null 2>&1; then
              echo "Backend ready"
              break
            fi
            echo "Waiting for backend ($i)"
            sleep 2
          done

      - name: Install frontend deps
        working-directory: ${{ env.FRONTEND_DIR }}
        run: |
          npm ci

      - name: Start frontend dev server
        working-directory: ${{ env.FRONTEND_DIR }}
        run: |
          nohup npm run dev -- --port $FRONTEND_PORT > frontend.out 2>&1 &
          echo "Frontend started."

      - name: Wait for frontend to respond
        run: |
          for i in $(seq 1 40); do
            if curl -s "http://localhost:${{ env.FRONTEND_PORT }}" >/dev/null 2>&1; then
              echo "Frontend ready"
              break
            fi
            echo "Waiting for frontend ($i)"
            sleep 2
          done

      - name: Install Playwright browsers
        working-directory: ${{ env.PLAYWRIGHT_TEST_DIR }}
        run: npx playwright install --with-deps

      - name: Run Playwright tests
        working-directory: ${{ env.PLAYWRIGHT_TEST_DIR }}
        env:
          BASE_URL: http://localhost:${{ env.FRONTEND_PORT }}
        run: |
          npx playwright test --project=chromium --reporter=list --reporter=html

      - name: Upload Playwright report artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: |
            ${{ env.PLAYWRIGHT_TEST_DIR }}/playwright-report
            ${{ env.PLAYWRIGHT_TEST_DIR }}/playwright-report.html
            ${{ env.PLAYWRIGHT_TEST_DIR }}/test-results
            ${{ env.BACKEND_DIR }}/backend.out
            ${{ env.FRONTEND_DIR }}/frontend.out

  cypress:
    name: Cypress E2E
    runs-on: ubuntu-latest
    timeout-minutes: 30
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: testdb
        ports:
          - 5434:5432
        options: >-
          --health-cmd="pg_isready -U postgres"
          --health-interval=5s
          --health-timeout=5s
          --health-retries=5
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'

      - name: Install backend dependencies
        working-directory: ${{ env.BACKEND_DIR }}
        run: |
          python -m venv venv
          . venv/bin/activate
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: Start backend
        working-directory: ${{ env.BACKEND_DIR }}
        run: |
          . venv/bin/activate
          nohup python run.py > backend.out 2>&1 &
          echo "Backend started."

      - name: Wait for backend to be ready
        run: |
          for i in $(seq 1 40); do
            if curl -s "http://${{ env.BACKEND_HOST }}:${{ env.BACKEND_PORT }}/api/v1/knime/workflows" >/dev/null 2>&1; then
              echo "Backend ready"
              break
            fi
            echo "Waiting for backend ($i)"
            sleep 2
          done

      - name: Install frontend deps
        working-directory: ${{ env.FRONTEND_DIR }}
        run: |
          npm ci

      - name: Start frontend dev server
        working-directory: ${{ env.FRONTEND_DIR }}
        run: |
          nohup npm run dev -- --port $FRONTEND_PORT > frontend.out 2>&1 &
          echo "Frontend started."

      - name: Wait for frontend to respond
        run: |
          for i in $(seq 1 40); do
            if curl -s "http://localhost:${{ env.FRONTEND_PORT }}" >/dev/null 2>&1; then
              echo "Frontend ready"
              break
            fi
            echo "Waiting for frontend ($i)"
            sleep 2
          done

      - name: Install Cypress
        working-directory: ${{ env.CYPRESS_DIR }}
        run: npm ci

      - name: Run Cypress tests (headless)
        working-directory: ${{ env.CYPRESS_DIR }}
        env:
          CYPRESS_baseUrl: http://localhost:${{ env.FRONTEND_PORT }}
        run: |
          npx cypress run --reporter junit --reporter-options "mochaFile=reports/junit-[hash].xml,toConsole=true"

      - name: Upload Cypress artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: cypress-artifacts
          path: |
            ${{ env.CYPRESS_DIR }}/reports
            ${{ env.CYPRESS_DIR }}/cypress/videos
            ${{ env.CYPRESS_DIR }}/cypress/screenshots
            ${{ env.BACKEND_DIR }}/backend.out
            ${{ env.FRONTEND_DIR }}/frontend.out

  publish_playwright_report:
    name: Publish Playwright HTML Report (GitHub Pages)
    runs-on: ubuntu-latest
    needs: playwright
    if: ${{ needs.playwright.result == 'success' }}
    steps:
      - name: Checkout repo (for pages metadata)
        uses: actions/checkout@v4

      - name: Download Playwright report artifact
        uses: actions/download-artifact@v4
        with:
          name: playwright-report
          path: playwright-report-artifact

      - name: List downloaded files
        run: |
          echo "Downloaded artifact contents:"
          ls -la playwright-report-artifact || true

      - name: Prepare Pages artifact
        # The upload-pages-artifact action expects a directory; ensure we point to the HTML report folder.
        uses: actions/upload-pages-artifact@v1
        with:
          path: playwright-report-artifact

      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v1

      - name: Output Pages URL
        run: |
          echo "Playwright HTML report deployed. Check the Actions run summary -> Pages section for URL."
